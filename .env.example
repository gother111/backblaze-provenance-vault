# Never expose these values to the browser. The API reads them server-side only.
PROVENANCE_DATA_DIR=data
PROVENANCE_DEFAULT_PROVIDER=local
PROVENANCE_STORAGE_MODE=local

# Backblaze B2 live storage
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004
B2_PUBLIC_URL_BASE=

# Optional live image providers orchestrated through Genblaze
GMI_API_KEY=
GMI_IMAGE_MODEL=seedream-5.0-lite
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
